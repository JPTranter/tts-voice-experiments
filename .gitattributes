# Normalise line endings in the repo, check out native on Windows.
* text=auto

*.md   text
*.py   text diff=python
*.sh   text eol=lf
*.json text
*.yaml text
*.yml  text
*.txt  text

# Binary assets — never diff or normalise these.
*.mp3  binary
*.wav  binary
*.pcm  binary
*.onnx binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.zip  binary
