# ---- Secrets / local config (policy mirrored from the sibling eClock repo) ----
# Never commit API keys, tokens or anything machine-specific. The OpenRouter key used by
# this project lives in the Hermes profile .env, OUTSIDE this repository:
#   ~/AppData/Local/hermes/profiles/engineer/.env   (OPENROUTER_API_KEY=...)
# Scripts resolve it via $OPENROUTER_API_KEY or that path - never from a file here.
.env
.env.*
!.env.example
*.local.ini
*.local.json
secrets.json

# caches and probes: regenerable, not deliverables
audio/birthday/raw/
audio/birthday/parts/
audio/emotion_probe/
audio/_speed_probe/
audio/renders/
audio/local/_tmp*
# local_tts.py provenance manifests: metadata is in results/sample_inventory.json
audio/local/*.manifest.json
__pycache__/
*.pyc
# scratch wav intermediates
*.wav
# local engine environment and large model weights (re-fetch with fetch_piper_voices.py)
.venv/
models/
